# Copy to backend/.env and adjust if needed. All values below are safe defaults; no API keys are required.
RESUMEIQ_DATABASE_URL=sqlite:///./var/resumeiq.db
# JSON list. Keep this to the local React dev origin(s); never use "*".
RESUMEIQ_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
RESUMEIQ_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RESUMEIQ_MODEL_CACHE_DIR=./var/models
RESUMEIQ_PRELOAD_MODEL=true
RESUMEIQ_AUTO_MIGRATE=true
RESUMEIQ_LOG_LEVEL=INFO
# Unvalidated matching thresholds (see README "Machine learning methodology")
# RESUMEIQ_THRESHOLD_SEMANTIC_MATCH=0.55
# RESUMEIQ_THRESHOLD_SEMANTIC_UNCERTAIN=0.40
